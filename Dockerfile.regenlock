ARG BASE_IMAGE=nvcr.io/nvidia/cuda-dl-base:26.04-cuda13.2-devel-ubuntu24.04
FROM ${BASE_IMAGE}
ENV UV_PYTHON_DOWNLOADS=never
RUN command -v python3 >/dev/null 2>&1 || (apt-get update && apt-get install -y python3 python3-venv curl)
RUN curl -LsSf https://astral.sh/uv/0.8.22/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"
WORKDIR /w
COPY . /w
# Build a venv with the build backends that the no-build-isolation git deps
# (deep-ep, transformer-engine, ...) import at metadata time, then point uv at it.
RUN uv venv /opt/lockenv --python python3 \
 && VIRTUAL_ENV=/opt/lockenv uv pip install --python /opt/lockenv/bin/python setuptools wheel packaging pybind11 psutil ninja torch
RUN VIRTUAL_ENV=/opt/lockenv UV_PROJECT_ENVIRONMENT=/opt/lockenv uv lock --python /opt/lockenv/bin/python
RUN echo "===UVLOCK_BEGIN===" && cat /w/uv.lock && echo "===UVLOCK_END==="
