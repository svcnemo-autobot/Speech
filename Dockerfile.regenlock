ARG BASE_IMAGE=nvcr.io/nvidia/cuda-dl-base:26.04-cuda13.2-devel-ubuntu24.04
FROM ${BASE_IMAGE}
ENV UV_PYTHON_DOWNLOADS=never
ENV CUDA_HOME=/usr/local/cuda
RUN command -v python3 >/dev/null 2>&1 || (apt-get update && apt-get install -y python3 python3-venv curl)
RUN curl -LsSf https://astral.sh/uv/0.8.22/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"
WORKDIR /w
COPY . /w
# deep-ep / TE setup.py import setuptools + torch (CUDAExtension) at metadata
# time and are in uv's no-build-isolation-package list (ambient interpreter),
# so provide those build backends system-wide and point at the CUDA toolkit.
RUN uv pip install --system --break-system-packages setuptools wheel packaging numpy \
 && uv pip install --system --break-system-packages --index-url https://download.pytorch.org/whl/cpu torch
RUN ls -d /usr/local/cuda* 2>/dev/null; echo "CUDA_HOME=$CUDA_HOME"
RUN uv lock --upgrade-package pillow
RUN echo "===UVLOCK_BEGIN===" && cat /w/uv.lock && echo "===UVLOCK_END==="
